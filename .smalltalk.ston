SmalltalkCISpec {
  #loading : [
    SCIMetacelloLoadSpec {
      #baseline : 'PharoXPEventRecorder',
      #directory : 'src',
      #load : [ 'Tests', 'Dispatcher' ],
      #platforms : [ #pharo ],
      #onConflict : #useIncoming,
      #onUpgrade : #useIncoming
    }
  ],
  #testing : {
    #include : {
      #packages : [ 'EventRecorder.*', 'Phex-Data-Dispatcher.*', 'Pharo-XP-EventRecorder.*' ]
    }
  }
}
